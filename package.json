{
  "name": "worldsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular, deterministic world-simulation template: stars and planets, climate and biomes, genetics and evolution, brains, and societies.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sim": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "site": "node scripts/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
